<?xml version="1.0" encoding="utf-8"?>
<!-- Trust user-installed CAs too, so servers using a self-hosted CA (e.g. https://manga.home)
     work in the app the same way they do in the phone's browser. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
